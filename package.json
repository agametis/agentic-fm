  "repository": {
    "type": "git",
    "url": "git+https://github.com/agametis/agentic-fm-with-duckdb-tools.git"
  },
  "bugs": {
    "url": "https://github.com/agametis/agentic-fm-with-duckdb-tools/issues"
  },
  "homepage": "https://github.com/agametis/agentic-fm-with-duckdb-tools#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
