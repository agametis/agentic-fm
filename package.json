    "duckdb:session:refresh": "node duckdb/main.mjs session refresh",
    "duckdb:session:stop": "node duckdb/main.mjs session stop",
    "duckdb:index": "node duckdb/main.mjs session refresh",
    "duckdb:search": "node duckdb/main.mjs search",
